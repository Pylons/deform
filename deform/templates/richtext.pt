<div tal:define="delayed_load delayed_load|field.widget.delayed_load;
                 tinymce_options tinymce_options|field.widget.tinymce_options;
                 oid oid|field.oid;
                 error_class error_class|field.widget.error_class;
                 name name|field.name;"
    xmlns:i18n="http://xml.zope.org/namespaces/i18n"
    i18n:domain="deform"
    tal:omit-tag="">
  <textarea id="${oid}" name="${name}"
            class="tinymce form-control ${field.error and error_class or ''}" tal:content="cstruct" />
  <!--!
    NB: disable delayed_load on error redisplay of form, since
    that might result in non-HTML-escaped interpolation of
    user input.
  -->
  <script type="text/javascript">
    deform.addCallback('${oid}', function(oid) {
        var options = {
            body_class: 'form-control ${field.error and error_class or ""}',
                <tal:block condition="tinymce_options">${tinymce_options},</tal:block>
                selector: '#' + oid
        };
        // English is TinyMCE's built-in default (no langs/en.js ships);
        // only request a language pack for non-English locales, which
        // have a matching langs/<code>.js file.
        var lang = '<tal:block i18n:translate="language-code">en</tal:block>';
        if (lang && lang !== 'en') {
            options.language = lang;
        }
        var el = document.getElementById(oid);
        if ('${delayed_load and not field.error}' == 'True') {
            el.addEventListener('click', function once() {
                el.removeEventListener('click', once);
                tinymce.init(options);
            });
        } else {
            tinymce.init(options);
        }
    });

    // Flush TinyMCE editor content back into the underlying textareas before
    // any form is serialized/submitted.
    if (!window._deformTinymceSyncBound) {
        window._deformTinymceSyncBound = true;
        var syncTinymce = function () {
            if (window.tinymce) {
                tinymce.triggerSave();
            }
        };
        document.addEventListener('submit', syncTinymce, true);
    }
  </script>
</div>
